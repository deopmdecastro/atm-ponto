# Backend production (Node/Express)
PORT=3001
NODE_ENV=production

# Postgres (prefer DATABASE_URL in production)
DATABASE_URL=postgresql://user:pass@host:5432/dbname
PGSSLMODE=require

# Comma-separated list of allowed frontend origins. Do not use "*" in production.
CORS_ORIGIN=https://<your-frontend>.vercel.app

# Set to false after creating the authorized accounts if public registration is not needed.
REGISTRATION_ENABLED=true

# Where uploaded files are stored (use a persistent disk path in production)
UPLOADS_DIR=/var/data/uploads
